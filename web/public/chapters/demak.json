  "beats": [
    {
      "id": "coast",
      "eyebrow": "Demak, Central Java",
      "headline": "A coast of ponds and villages",
      "body": "East of Semarang, the coast of Demak is a patchwork of fishponds, rice fields and villages built only just above the sea.",
      "stage": {
        "mode": "flyover",
        "flyover": { "from": 0, "to": 20, "playback": "play-hold" },
        "left": "optical_2026",
        "right": "sar_2026",
        "swipe": 0.5
      }
    },
    {
      "id": "what_radar_sees",
      "eyebrow": "How it works",
      "headline": "Water goes dark, walls shine",
      "body": "Drag the divider between the optical view and NISAR's radar. Calm water reflects the radar away and goes dark. Houses and trees bounce it back and shine, even where they stand in the sea.",
      "stage": {
        "mode": "radar",
        "flyover": { "from": 20, "to": 20, "playback": "play-hold" },
        "left": "optical_2026",
        "right": "sar_2026",
        "swipe": 0.5
      }
    },
    {
      "id": "then_now",
      "eyebrow": "Then and now",
      "headline": "Land the sea took",
      "body": "On the left, the coast in the dry season of 2017. On the right, NISAR in 2026. Since 1984, about {fact:land_lost_ha} of Semarang and Demak has been lost to the sea.",
      "stage": {
        "mode": "radar",
        "flyover": { "from": 20, "to": 20, "playback": "play-hold" },
        "left": "optical_baseline",
        "right": "sar_2026",
        "swipe": 0.5
      }
    },
    {
      "id": "sinking",
      "eyebrow": "Why",
      "headline": "The ground is sinking",
      "body": "Pumping groundwater compacts the soft delta soil. In Sayung district the ground sank by up to {fact:subsidence_max_cmyr} in surveys, far faster than the sea rises. NISAR's interferograms will measure this as the record grows; these figures come from published surveys.",
      "stage": {
        "mode": "radar",
        "flyover": { "from": 20, "to": 20, "playback": "play-hold" },
        "left": "optical_2026",
        "right": "sar_2026",
        "swipe": 0.5
      }
    },
    {
      "id": "act",
      "eyebrow": "What helps",
      "headline": "Let the mangroves come back",
      "body": "Brushwood fences calm the waves and trap mud, so mangroves can take root again and hold the coast. Communities in Demak build them with the organizations on the next screen.",
      "stage": {
        "mode": "radar",
        "flyover": { "from": 20, "to": 20, "playback": "play-hold" },
        "left": "optical_2026",
        "right": "sar_2026",
        "swipe": 0.5
      }
    }
  ],
