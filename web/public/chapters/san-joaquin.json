    },
    {
      "id": "phase",
      "eyebrow": "How it works",
      "headline": "Radar counts wavelengths",
      "body": "Two radar passes see the same ground. If the surface moved between them, the return signal is shifted by a fraction of a wavelength, and that shift converts to centimeters.",
      "stage": {
        "mode": "radar",
        "flyover": { "from": 8, "to": 16, "playback": "scrub" },
        "left": "optical_after",
        "right": "displacement",
