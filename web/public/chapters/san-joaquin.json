      "headline": "A bowl in the valley floor",
      "body": "The deepest point sank {stat:max_subsidence_cm} in this series, a rate of {stat:rate_cm_per_month}. Around it, {stat:area_over_5cm_ha} sank past the five-centimeter mark.",
      "stage": {
        "mode": "radar",
        "flyover": { "from": 16, "to": 26, "playback": "scrub" },
