  "kicker": "San Joaquin Valley, California",
  "title": "The ground is sinking",
  "dek": "Pumping groundwater lowers the land. Repeat radar passes measure that sinking in centimeters, across a whole valley at once.",
  "aoi": {
    "bbox": [-119.95, 35.85, -119.05, 36.45],
    "placeName": "San Joaquin Valley",
    "countryCode": "US"
  },
  "radar": {
    "product": "GUNW",
    "band": "L",
    "mechanism": "interferometric-phase",
    "polarizations": ["HH"],
    "explainer": "Two radar passes see the same ground. If the surface moved between them, the returning wave is shifted by a fraction of a wavelength. That phase shift converts to centimeters of motion along the radar's line of sight. Where the surface changes too much, the phase is noise and coherence is low."
  },
  "legend": [
    {
      "id": "displacement",
      "layerIds": ["displacement"],
      "swatch": {
        "kind": "ramp",
        "stops": ["#67001f", "#d6604d", "#f7f7f7", "#4393c3", "#053061"],
        "domain": [-15, 15],
        "unit": "cm"
      },
      "label": "Red to blue",
      "meaning": "Red: the ground moved away from the satellite, which means sinking. White: no change. Blue: the ground moved toward the satellite."
    },
    {
      "id": "coherence",
      "layerIds": ["coherence"],
      "swatch": {
        "kind": "ramp",
        "stops": ["#000000", "#969696", "#ffffff"],
        "domain": [0, 1],
        "unit": "ratio"
      },
      "label": "Dark to light",
      "meaning": "How well the two radar passes match. Dark pixels give unreliable ground motion, and the displacement layer leaves them out."
    },
    {
      "id": "sar_fields",
      "layerIds": ["sar_after"],
      "swatch": { "kind": "solid", "color": "#808680" },
      "label": "Grey-green",
      "meaning": "Irrigated farmland. Each field returns its own level of radar signal."
    },
    {
      "id": "optical_fields",
      "layerIds": ["optical_after"],
      "swatch": { "kind": "solid", "color": "#5C8038" },
      "label": "Green and tan patches",
      "meaning": "Fields in visible light: crops and bare soil."
    }
  ],
  "beats": [
    {
      "id": "valley",
      "eyebrow": "San Joaquin Valley, California",
      "headline": "Flat land, quiet change",
      "body": "The San Joaquin Valley is flat farmland watered by canals and wells. Nothing in this view appears to move.",
      "stage": {
        "mode": "flyover",
        "flyover": { "from": 0, "to": 8, "playback": "scrub" },
        "left": "optical_after",
