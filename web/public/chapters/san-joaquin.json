    {
      "id": "pumping",
      "eyebrow": "Why it sinks",
      "headline": "Water out, land down",
      "body": "When groundwater is pumped faster than it refills, the soil layers that held the water compact. Much of that compaction does not reverse.",
      "stage": {
        "mode": "split",
        "flyover": { "from": 26, "to": 32, "playback": "scrub" },
        "left": "optical_after",
        "right": "displacement",
        "swipe": 0.5,
        "annotations": ["deepest_point"]
      },
      "readout": { "seriesId": "displacement_hotspot" }
    },
    {
      "id": "act",
      "eyebrow": "What helps",
      "headline": "Clean water for the valley",
      "body": "Sinking land can damage canals and wells, and falling water tables can leave household wells dry. Two organizations work with valley communities on water and housing.",
      "stage": {
        "mode": "flyover",
        "flyover": { "from": 32, "to": 36, "playback": "play-hold" },
        "left": "optical_after",
