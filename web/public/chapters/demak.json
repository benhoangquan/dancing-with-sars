  "radar": {
    "product": "GCOV",
    "band": "L",
    "mechanism": "specular-reflection",
    "polarizations": ["HH", "HV"],
    "explainer": "Calm water acts like a mirror for NISAR's L-band radar and reflects the signal away, so it shows dark. Walls and houses standing in water bounce it straight back and shine. That contrast maps where land ends and water begins, by day or night and through cloud."
  },
