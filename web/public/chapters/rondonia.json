    },
    {
      "id": "act",
      "eyebrow": "What helps",
      "headline": "Keep the canopy standing",
      "body": "Radar shows where clearing starts. Keeping forest standing depends on land protection and on the communities who live in it. Two organizations work on that in the Amazon.",
      "stage": {
        "mode": "flyover",
        "flyover": { "from": 32, "to": 36, "playback": "play-hold" },
