{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dancing-with-sars.invalid/schema/chapter.schema.json",
  "title": "Chapter",
  "description": "One scrollytelling chapter manifest (schemaVersion 1). Authored fields are edited by hand; `generated` is written by the sar pipeline.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "slug", "order", "theme", "accent", "kicker", "title", "dek", "aoi", "radar", "legend", "beats", "action", "generated"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]{2,40}$" },
    "order": { "type": "integer", "minimum": 1 },
    "theme": { "enum": ["forest", "fire", "ground", "water", "ice"] },
    "accent": { "$ref": "#/$defs/Color" },
    "kicker": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "dek": { "type": "string", "minLength": 1 },
    "aoi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bbox", "placeName", "countryCode"],
      "properties": {
        "bbox": { "$ref": "#/$defs/BBox" },
        "placeName": { "type": "string", "minLength": 1 },
        "countryCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "iso3": { "type": "string", "pattern": "^[A-Z]{3}$", "description": "ISO 3166-1 alpha-3, shown in globe callouts as 'Name · ISO3'." }
      }
    },
    "radar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "band", "mechanism", "polarizations", "explainer"],
      "properties": {
        "product": { "enum": ["GCOV", "GUNW", "GOFF"] },
        "band": { "enum": ["L", "S"] },
        "mechanism": { "enum": ["volume-scattering-loss", "specular-reflection", "double-bounce", "interferometric-phase", "pixel-offset"] },
        "polarizations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["HH", "HV", "VV", "VH"] } },
        "explainer": { "type": "string", "minLength": 1, "maxLength": 400 }
      }
    },
    "legend": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/LegendEntry" } },
    "beats": { "type": "array", "minItems": 4, "maxItems": 7, "items": { "$ref": "#/$defs/Beat" } },
    "action": { "$ref": "#/$defs/ActionContent" },
    "globe": {
      "type": "object", "additionalProperties": false, "required": ["pin"],
      "properties": { "pin": { "$ref": "#/$defs/LonLat" } },
      "description": "Where the chapter's hotspot pin sits on the globe. Defaults to the bbox centre."
    },
    "openingCamera": { "$ref": "#/$defs/Camera", "description": "Pose where Act I's flyover ends and the Act II map opens. Equals the last flyover waypoint." },
    "facts": { "type": "array", "items": { "$ref": "#/$defs/Fact" }, "description": "Sourced numbers for {fact:id} tokens." },
    "scaleAnchors": {
      "type": "object", "patternProperties": { "^[a-z0-9_]+$": { "$ref": "#/$defs/ScaleReference" } }, "additionalProperties": false,
      "description": "Stat or fact key -> the everyday reference it is compared with."
    },
    "landmarks": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/Landmark" } },
    "soundscape": {
      "type": "object", "additionalProperties": false, "required": ["before", "after"],
      "properties": { "before": { "$ref": "#/$defs/Sound" }, "after": { "$ref": "#/$defs/Sound" } }
    },
    "generated": { "$ref": "#/$defs/Generated" }
  },
  "$defs": {
    "LonLat": {
      "tsType": "[number, number]",
      "type": "array", "prefixItems": [{ "type": "number", "minimum": -180, "maximum": 180 }, { "type": "number", "minimum": -90, "maximum": 90 }],
      "items": false, "minItems": 2, "maxItems": 2, "description": "WGS84 [lon, lat]"
    },
    "BBox": {
      "tsType": "[number, number, number, number]",
      "type": "array", "prefixItems": [{ "type": "number", "minimum": -180, "maximum": 180 }, { "type": "number", "minimum": -90, "maximum": 90 }, { "type": "number", "minimum": -180, "maximum": 180 }, { "type": "number", "minimum": -90, "maximum": 90 }],
      "items": false, "minItems": 4, "maxItems": 4, "description": "[west, south, east, north]"
    },
    "NumberPair": { "tsType": "[number, number]", "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }], "items": false, "minItems": 2, "maxItems": 2 },
    "ISODate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "DateOrRange": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}(/\\d{4}-\\d{2}-\\d{2})?$" },
    "DatePair": { "tsType": "[ISODate, ISODate]", "type": "array", "prefixItems": [{ "$ref": "#/$defs/ISODate" }, { "$ref": "#/$defs/ISODate" }], "items": false, "minItems": 2, "maxItems": 2 },
    "AssetPath": { "type": "string", "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$", "description": "Relative to web/public. No leading slash, scheme or '..'." },
    "HttpsUrl": { "type": "string", "pattern": "^https://[^\\s]+$" },
    "Color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "Id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "Unit": { "enum": ["dB", "cm", "ha", "m", "ratio", "%", "count", "cm/month", "m/day", "cm/yr", "km2", "km"] },
    "ScaleReference": { "enum": ["football-pitch", "central-park", "manhattan", "echo-power", "per-decade"] },
    "Fact": {
      "type": "object", "additionalProperties": false, "required": ["id", "value", "unit", "decimals", "label", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "value": { "type": "number" },
        "unit": { "$ref": "#/$defs/Unit" },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 6 },
        "label": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/MetricSource" }
      }
    },
    "Photo": {
      "type": "object", "additionalProperties": false, "required": ["src", "credit", "license", "licenseUrl", "sourceUrl", "caption", "where"],
      "properties": {
        "src": { "$ref": "#/$defs/AssetPath" },
        "credit": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "licenseUrl": { "$ref": "#/$defs/HttpsUrl" },
        "sourceUrl": { "$ref": "#/$defs/HttpsUrl" },
        "caption": { "type": "string", "minLength": 1 },
        "where": { "type": "string", "minLength": 1, "description": "How close to the pin the photo was taken, in plain words." }
      }
    },
    "Landmark": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "lonLat"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "label": { "type": "string", "minLength": 1 },
        "lonLat": { "$ref": "#/$defs/LonLat" },
        "note": { "type": "string", "minLength": 1 },
        "photo": { "$ref": "#/$defs/Photo" }
      }
    },
    "Sound": {
      "type": "object", "additionalProperties": false, "required": ["src", "label", "credit", "license", "sourceUrl", "synthesized"],
      "properties": {
        "src": { "$ref": "#/$defs/AssetPath" },
        "label": { "type": "string", "minLength": 1 },
        "credit": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "sourceUrl": { "$ref": "#/$defs/HttpsUrl" },
        "synthesized": { "type": "boolean" }
      }
    },
    "Reading": {
      "type": "object", "additionalProperties": false, "required": ["label", "value", "unit", "decimals", "layerId"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": "number" },
        "unit": { "$ref": "#/$defs/Unit" },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 6 },
        "layerId": { "$ref": "#/$defs/Id" }
      }
    },
    "StageMode": { "enum": ["flyover", "radar", "split"] },
    "DataStatus": { "enum": ["real", "fallback", "illustrative"] },
    "Camera": {
      "type": "object", "additionalProperties": false, "required": ["center", "zoom", "pitch", "bearing"],
      "properties": {
        "center": { "$ref": "#/$defs/LonLat" },
        "zoom": { "type": "number", "minimum": 0, "maximum": 22 },
        "pitch": { "type": "number", "minimum": 0, "maximum": 85 },
        "bearing": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "LegendSwatch": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "color"], "properties": { "kind": { "const": "solid" }, "color": { "$ref": "#/$defs/Color" } } },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "stops", "domain", "unit"],
          "properties": {
            "kind": { "const": "ramp" },
            "stops": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/Color" } },
            "domain": { "$ref": "#/$defs/NumberPair" },
            "unit": { "$ref": "#/$defs/Unit" }
          }
        }
      ]
    },
    "LegendEntry": {
      "type": "object", "additionalProperties": false, "required": ["id", "layerIds", "swatch", "label", "meaning"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "layerIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Id" }, "description": "Shown when any of these layers is visible." },
        "swatch": { "$ref": "#/$defs/LegendSwatch" },
        "label": { "type": "string", "minLength": 1 },
        "meaning": { "type": "string", "minLength": 1 }
      }
    },
    "Beat": {
      "type": "object", "additionalProperties": false, "required": ["id", "headline", "body", "stage"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "eyebrow": { "type": "string" },
        "headline": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1, "description": "May contain {stat:key} tokens resolved from generated.stats." },
        "stage": {
          "type": "object", "additionalProperties": false, "required": ["mode", "flyover", "left", "right", "swipe"],
          "properties": {
            "mode": { "$ref": "#/$defs/StageMode" },
            "flyover": {
              "type": "object", "additionalProperties": false, "required": ["from", "to", "playback"],
              "properties": {
                "from": { "type": "number", "minimum": 0 },
                "to": { "type": "number", "minimum": 0 },
                "playback": { "enum": ["scrub", "play-hold"] }
              }
            },
            "camera": { "$ref": "#/$defs/Camera" },
            "left": { "$ref": "#/$defs/Id" },
            "right": { "$ref": "#/$defs/Id" },
            "flyoverLayer": { "$ref": "#/$defs/Id" },
            "swipe": { "type": "number", "minimum": 0, "maximum": 1 },
            "overlays": { "type": "array", "items": { "$ref": "#/$defs/Id" } },
            "annotations": { "type": "array", "items": { "$ref": "#/$defs/Id" } }
          }
        },
        "readout": {
          "type": "object", "additionalProperties": false, "required": ["seriesId"],
          "properties": {
            "seriesId": { "$ref": "#/$defs/Id" },
            "window": { "$ref": "#/$defs/DatePair" },
            "cursor": { "$ref": "#/$defs/ISODate" },
            "statKey": { "$ref": "#/$defs/Id" }
          }
        }
      }
    },
    "MetricSource": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "url", "accessed"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "url": { "$ref": "#/$defs/HttpsUrl" }, "accessed": { "$ref": "#/$defs/ISODate" } }
    },
    "ImpactMetricStat": {
      "type": "object", "additionalProperties": false, "required": ["label", "statKey", "source"],
      "properties": { "label": { "type": "string", "minLength": 1 }, "statKey": { "$ref": "#/$defs/Id" }, "source": { "$ref": "#/$defs/MetricSource" } }
    },
    "ImpactMetricValue": {
      "type": "object", "additionalProperties": false, "required": ["label", "value", "unit", "source"],
      "properties": { "label": { "type": "string", "minLength": 1 }, "value": { "type": "number" }, "unit": { "type": "string", "minLength": 1 }, "source": { "$ref": "#/$defs/MetricSource" } }
    },
    "ImpactMetric": { "oneOf": [{ "$ref": "#/$defs/ImpactMetricStat" }, { "$ref": "#/$defs/ImpactMetricValue" }] },
    "Organization": {
      "type": "object", "additionalProperties": false, "required": ["name", "url", "focus", "region", "cta", "verified"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/HttpsUrl" },
        "focus": { "type": "string", "minLength": 1 },
        "region": { "type": "string", "minLength": 1 },
        "cta": {
          "type": "object", "additionalProperties": false, "required": ["label", "url"],
          "properties": { "label": { "type": "string", "minLength": 1 }, "url": { "$ref": "#/$defs/HttpsUrl" } }
        },
        "verified": {
          "type": "object", "additionalProperties": false, "required": ["on", "how"],
          "properties": { "on": { "$ref": "#/$defs/ISODate" }, "how": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "ActionContent": {
      "type": "object", "additionalProperties": false, "required": ["headline", "body", "metrics", "organizations"],
      "properties": {
        "headline": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1 },
        "metrics": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "$ref": "#/$defs/ImpactMetric" } },
        "organizations": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "$ref": "#/$defs/Organization" } },
        "local": {
          "type": "object", "additionalProperties": false, "required": ["headline", "body", "steps"],
          "properties": {
            "headline": { "type": "string", "minLength": 1 },
            "body": { "type": "string", "minLength": 1 },
            "steps": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "minLength": 1 } }
          },
          "description": "Tab 2 of the action modal: what someone can do where they live."
        }
      }
    },
    "LayerRender": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "rgba" } } },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "scheme", "domain", "unit"],
          "properties": {
            "type": { "const": "ramp" },
            "scheme": { "type": "string", "minLength": 1 },
            "domain": { "$ref": "#/$defs/NumberPair" },
            "unit": { "$ref": "#/$defs/Unit" }
          }
        }
      ]
    },
    "Layer": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "label", "date", "cog", "render", "preview", "bounds", "sourceIds", "status", "bytes", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "kind": { "enum": ["sar-composite", "sar-db", "optical", "change", "displacement", "coherence", "speed"] },
        "label": { "type": "string", "minLength": 1 },
        "date": { "$ref": "#/$defs/DateOrRange" },
        "cog": { "$ref": "#/$defs/AssetPath" },
        "render": { "$ref": "#/$defs/LayerRender" },
        "stretch": {
          "type": "object", "additionalProperties": false, "required": ["HH", "HV", "ratio"],
          "properties": { "HH": { "$ref": "#/$defs/NumberPair" }, "HV": { "$ref": "#/$defs/NumberPair" }, "ratio": { "$ref": "#/$defs/NumberPair" } }
        },
        "preview": { "$ref": "#/$defs/AssetPath" },
        "bounds": { "$ref": "#/$defs/BBox" },
        "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "status": { "$ref": "#/$defs/DataStatus" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "SeriesPoint": {
      "type": "object", "additionalProperties": false, "required": ["t", "v"],
      "properties": { "t": { "$ref": "#/$defs/ISODate" }, "v": { "type": "number" } }
    },
    "Series": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "unit", "kind", "points", "sourceIds", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "label": { "type": "string", "minLength": 1 },
        "unit": { "$ref": "#/$defs/Unit" },
        "kind": { "enum": ["hv-backscatter", "displacement", "affected-area", "speed"] },
        "points": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/SeriesPoint" } },
        "reference": {
          "type": "object", "additionalProperties": false, "required": ["label", "points"],
          "properties": { "label": { "type": "string", "minLength": 1 }, "points": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/SeriesPoint" } } }
        },
        "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "status": { "$ref": "#/$defs/DataStatus" }
      }
    },
    "Stat": {
      "type": "object", "additionalProperties": false, "required": ["value", "unit", "decimals", "label", "method"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "$ref": "#/$defs/Unit" },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 6 },
        "label": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 }
      }
    },
    "Waypoint": {
      "type": "object", "additionalProperties": false, "required": ["t", "camera"],
      "properties": { "t": { "type": "number", "minimum": 0 }, "camera": { "$ref": "#/$defs/Camera" } }
    },
    "Flyover": {
      "type": "object", "additionalProperties": false, "required": ["duration", "exaggeration", "waypoints"],
      "properties": {
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "exaggeration": { "type": "number", "minimum": 0, "maximum": 5 },
        "waypoints": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/Waypoint" } },
        "video": {
          "type": "object", "additionalProperties": false, "required": ["src", "poster", "width", "height", "fps", "keyint", "bytes"],
          "properties": {
            "src": { "$ref": "#/$defs/AssetPath" },
            "poster": { "$ref": "#/$defs/AssetPath" },
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "fps": { "type": "number", "exclusiveMinimum": 0 },
            "keyint": { "type": "integer", "minimum": 1 },
            "bytes": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "PointGeometry": {
      "type": "object", "additionalProperties": false, "required": ["type", "coordinates"],
      "properties": { "type": { "const": "Point" }, "coordinates": { "$ref": "#/$defs/LonLat" } }
    },
    "PolygonGeometry": {
      "type": "object", "additionalProperties": false, "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "Polygon" },
        "coordinates": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/LonLat" } } }
      }
    },
    "MultiPolygonGeometry": {
      "type": "object", "additionalProperties": false, "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "MultiPolygon" },
        "coordinates": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/LonLat" } } } }
      }
    },
    "Annotation": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "kind", "geometry"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "label": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["pin", "area"] },
        "geometry": { "oneOf": [{ "$ref": "#/$defs/PointGeometry" }, { "$ref": "#/$defs/PolygonGeometry" }] }
      }
    },
    "Source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "mission", "product", "collection", "maturity", "granules", "dates", "provider", "license", "url", "nasa"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "mission": { "enum": ["NISAR", "Sentinel-1", "HLS", "NASADEM", "Synthetic", "Copernicus DEM", "Overture Maps", "OpenStreetMap", "BC Wildfire Service", "US Interagency Fire (WFIGS)", "Wikimedia Commons", "Published study"] },
        "product": { "type": "string", "minLength": 1 },
        "collection": { "type": "string", "minLength": 1 },
        "maturity": { "enum": ["beta", "provisional", "validated", "n/a"] },
        "granules": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "dates": { "type": "array", "items": { "$ref": "#/$defs/ISODate" } },
        "provider": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/HttpsUrl" },
        "nasa": { "type": "boolean" }
      }
    },
    "Generated": {
      "type": "object", "additionalProperties": false,
      "required": ["pipelineVersion", "builtAt", "layers", "series", "stats", "flyover", "annotations", "sources"],
      "properties": {
        "pipelineVersion": { "type": "string", "minLength": 1 },
        "builtAt": { "type": "string", "format": "date-time" },
        "layers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Layer" } },
        "series": { "type": "array", "items": { "$ref": "#/$defs/Series" } },
        "stats": { "type": "object", "patternProperties": { "^[a-z0-9_]+$": { "$ref": "#/$defs/Stat" } }, "additionalProperties": false },
        "flyover": { "$ref": "#/$defs/Flyover" },
        "annotations": { "type": "array", "items": { "$ref": "#/$defs/Annotation" } },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Source" } },
        "dem": {
          "type": "object", "additionalProperties": false, "required": ["cog", "bounds", "sourceIds", "bytes", "sha256"],
          "properties": {
            "cog": { "$ref": "#/$defs/AssetPath" },
            "bounds": { "$ref": "#/$defs/BBox" },
            "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "bytes": { "type": "integer", "minimum": 0 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          },
          "description": "Terrain for the map and the flyover, read with cog://...#dem."
        },
        "landmarkReadings": {
          "type": "object", "patternProperties": { "^[a-z0-9_]+$": { "type": "array", "items": { "$ref": "#/$defs/Reading" } } }, "additionalProperties": false
        },
        "impact": {
          "type": "object", "additionalProperties": false, "required": ["geojson", "bytes", "sha256", "counts", "sourceIds"],
          "properties": {
            "geojson": { "$ref": "#/$defs/AssetPath" },
            "bytes": { "type": "integer", "minimum": 0 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "counts": { "type": "object", "patternProperties": { "^[a-z0-9_]+$": { "type": "integer", "minimum": 0 } }, "additionalProperties": false },
            "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          },
          "description": "Buildings, roads and territories near the change, drawn on the radar stage."
        },
        "footprint": {
          "type": "object", "additionalProperties": false, "required": ["kind", "label", "areaHa", "geometry", "sourceIds", "status"],
          "properties": {
            "kind": { "enum": ["shape", "equal-area"], "description": "equal-area: a square of a cited area; the shape is not the real one." },
            "label": { "type": "string", "minLength": 1 },
            "areaHa": { "type": "number", "exclusiveMinimum": 0 },
            "geometry": { "oneOf": [{ "$ref": "#/$defs/PolygonGeometry" }, { "$ref": "#/$defs/MultiPolygonGeometry" }] },
            "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "status": { "$ref": "#/$defs/DataStatus" }
          },
          "description": "The area compared with a city in the action modal."
        }
      }
    }
  }
}
