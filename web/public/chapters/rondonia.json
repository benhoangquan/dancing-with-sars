{
  "schemaVersion": "1",
  "slug": "rondonia",
  "order": 1,
  "theme": "forest",
  "accent": "#30D158",
  "kicker": "Rondônia, Brazil",
  "title": "Roads open the forest from the inside",
  "dek": "Under cloud, a standing forest and a cleared one can look alike from orbit. L-band radar tells them apart, and shows where new roads and clearings spread between two passes.",
  "aoi": {
    "bbox": [-63.8, -10.4, -62.9, -9.7],
    "placeName": "Rondônia",
    "countryCode": "BR"
  },
  "radar": {
    "product": "GCOV",
    "band": "L",
    "mechanism": "volume-scattering-loss",
    "polarizations": ["HH", "HV"],
    "explainer": "NISAR's L-band radar has a wavelength of about 24 cm. It passes between leaves and bounces off branches and trunks, and that scattering returns strongly in the cross-polarized HV channel. Bare ground and pasture return far less HV, so a drop in HV marks canopy that is gone."
  },
  "legend": [
    {
      "id": "sar_forest",
      "layerIds": ["sar_before", "sar_after"],
      "swatch": { "kind": "solid", "color": "#B0D853" },
      "label": "Yellow-green",
      "meaning": "Standing forest. Branches and leaves scatter the radar in every direction, so the cross-polarized HV channel is strong."
    },
    {
      "id": "sar_cleared",
      "layerIds": ["sar_before", "sar_after"],
      "swatch": { "kind": "solid", "color": "#646E7A" },
      "label": "Slate grey",
      "meaning": "Cleared ground. Bare soil and pasture return much less HV."
    },
    {
      "id": "sar_water",
      "layerIds": ["sar_before", "sar_after"],
      "swatch": { "kind": "solid", "color": "#3E457E" },
      "label": "Indigo",
      "meaning": "Rivers and open water. They reflect the radar away, so very little returns."
    },
    {
      "id": "optical_forest",
      "layerIds": ["optical_before", "optical_after"],
      "swatch": { "kind": "solid", "color": "#1C4222" },
      "label": "Dark green",
      "meaning": "Forest canopy in visible light."
    },
    {
      "id": "optical_cleared",
      "layerIds": ["optical_before", "optical_after"],
      "swatch": { "kind": "solid", "color": "#B0966E" },
      "label": "Tan",
      "meaning": "Roads and cleared land in visible light."
    },
    {
      "id": "hv_drop",
      "layerIds": ["hv_change"],
      "swatch": {
        "kind": "ramp",
        "stops": ["#ffffcc", "#fed976", "#fd8d3c", "#e31a1c", "#800026"],
        "domain": [2, 10],
        "unit": "dB"
      },
      "label": "HV drop",
      "meaning": "How many decibels the HV signal fell between the two windows. Only pixels with a clear drop from forest are drawn."
    }
  ],
  "beats": [
    {
      "id": "orbit",
      "eyebrow": "Rondônia, Brazil",
      "headline": "A forest seen from above",
      "body": "This stretch of Rondônia sits in the Amazon's arc of deforestation, where branch roads leave a main road like the bones of a fish.",
      "stage": {
        "mode": "flyover",
        "flyover": { "from": 0, "to": 8, "playback": "scrub" },
        "left": "optical_before",
        "right": "sar_before",
        "swipe": 0.5
      }
    },
    {
      "id": "what_radar_sees",
      "eyebrow": "How it works",
      "headline": "Radar reads structure, not color",
      "body": "An optical image records the light that ground reflects. NISAR sends its own signal, passes through cloud and smoke, and measures how much returns from branches, trunks and bare soil.",
      "stage": {
        "mode": "radar",
        "flyover": { "from": 8, "to": 16, "playback": "scrub" },
        "left": "optical_before",
        "right": "sar_before",
        "swipe": 0.5
      }
    },
    {
      "id": "fishbone",
      "eyebrow": "Between two radar passes",
      "headline": "The fishbone spreads",
      "body": "The same ground, before and after. Where new clearings opened, the HV signal fell by {stat:hv_drop_db} on average.",
      "stage": {
        "mode": "radar",
        "flyover": { "from": 16, "to": 26, "playback": "scrub" },
        "left": "sar_before",
        "right": "sar_after",
        "swipe": 0.5,
        "overlays": ["hv_change"],
        "annotations": ["new_clearing"],
        "camera": {
          "center": [-63.568, -9.818],
          "zoom": 12.4,
          "pitch": 30,
          "bearing": 0
        }
      },
      "readout": { "seriesId": "hv_cleared", "statKey": "hv_drop_db" }
    },
    {
      "id": "measured",
      "eyebrow": "Measured",
      "headline": "Hectares, not impressions",
      "body": "Pixels whose HV fell past the threshold add up to {stat:cleared_ha} of forest cleared. Each radar date adds a point to the series, {stat:n_dates} dates in all.",
      "stage": {
        "mode": "split",
        "flyover": { "from": 26, "to": 32, "playback": "scrub" },
