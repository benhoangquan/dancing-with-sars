  "theme": "fire",
  "accent": "#FF9F0A",
  "kicker": "Okanagan, British Columbia",
  "title": "Seeing through the smoke",
  "dek": "Smoke hides a burning hillside from optical satellites. L-band radar passes through it and measures how much canopy the fire took.",
  "aoi": {
    "bbox": [-119.85, 49.75, -119.15, 50.25],
    "placeName": "Okanagan Valley",
    "countryCode": "CA"
  },
  "radar": {
    "product": "GCOV",
    "band": "L",
    "mechanism": "volume-scattering-loss",
    "polarizations": ["HH", "HV"],
    "explainer": "L-band radar passes through smoke and cloud. Standing forest scatters it back strongly in the HV channel. A burned stand keeps its trunks but loses needles, twigs and branches, so HV falls. Water acts like a mirror and returns almost nothing, so lakes look dark."
  },
  "legend": [
    {
      "id": "sar_forest",
      "layerIds": ["sar_before", "sar_after"],
      "swatch": { "kind": "solid", "color": "#A6C263" },
      "label": "Yellow-green",
      "meaning": "Standing forest, strong HV return."
    },
    {
      "id": "sar_burn",
      "layerIds": ["sar_before", "sar_after"],
      "swatch": { "kind": "solid", "color": "#868091" },
      "label": "Grey-violet",
      "meaning": "Burned forest. The canopy that scattered the radar is gone, so HV falls."
    },
    {
      "id": "sar_water",
      "layerIds": ["sar_before", "sar_after"],
      "swatch": { "kind": "solid", "color": "#000D55" },
      "label": "Dark navy",
      "meaning": "Open water. It reflects the radar away from the satellite, so almost nothing returns."
    },
    {
      "id": "optical_ground",
      "layerIds": ["optical_before"],
      "swatch": { "kind": "solid", "color": "#1E4824" },
      "label": "Dark green",
      "meaning": "Forest canopy in visible light."
    },
    {
      "id": "optical_smoke",
      "layerIds": ["optical_smoke"],
      "swatch": { "kind": "solid", "color": "#C4BEB8" },
      "label": "Grey haze",
      "meaning": "Smoke between the satellite and the ground. Optical sensors cannot see through it."
    },
    {
      "id": "optical_glow",
      "layerIds": ["optical_smoke"],
      "swatch": { "kind": "solid", "color": "#FF8C28" },
      "label": "Orange glow",
      "meaning": "Hot spots along the edge of the fire."
    },
    {
      "id": "hv_drop",
      "layerIds": ["hv_change"],
      "swatch": {
        "kind": "ramp",
        "stops": ["#ffffcc", "#fed976", "#fd8d3c", "#e31a1c", "#800026"],
        "domain": [2, 10],
        "unit": "dB"
      },
      "label": "HV drop",
      "meaning": "How many decibels the HV signal fell between the two windows. Only pixels with a clear drop from forest are drawn."
    }
  ],
  "beats": [
    {
      "id": "valley",
      "eyebrow": "Okanagan, British Columbia",
      "headline": "A valley in a dry summer",
      "body": "In August 2026 wildfires burned in the Okanagan, in forest above the lakes. This view starts from the ground before the fires.",
